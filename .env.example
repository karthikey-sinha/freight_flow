# Copy to .env and fill in. Without a key the project runs in rule-based MOCK mode.

# Which AI to use: anthropic (Claude, paid) | groq (free tier) | gemini (free tier)
LLM_PROVIDER=groq

# Paste the key for the provider you chose (others can stay empty)
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# Optional: override the model. Leave empty for the default of your provider.
# Check the exact current model names in your provider's console.
LLM_MODEL=

COMPANY_NAME=Prologis Freight India Pvt Ltd
# Force mock mode even if a key is set:
# FREIGHTFLOW_MOCK=1

# Minutes a person spends per task by hand (drives the "time saved" metric)
MIN_TRIAGE=2
MIN_DOCUMENT=8
MIN_DRAFT=5
